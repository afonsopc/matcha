PORT=3000
# Generate your own: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-64-hex-string
# Used to build the links inside emails. Must be reachable from where you open the email.
APP_URL=http://localhost:3000
DATABASE_PATH=./data/matcha.sqlite

# console = verification/reset links are printed in the server console only.
# smtp    = links are delivered by email through the SMTP server below.
MAIL_MODE=smtp

# Gmail: turn on 2-step verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste it in SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=
# Optional. Defaults to "Matcha <SMTP_USER>". Most providers reject a
# From address that does not belong to the account you log in with.
MAIL_FROM=
