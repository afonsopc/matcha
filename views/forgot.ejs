<%- include('partials/head', { title: 'Reset password' }) %>
<section class="auth">
  <div class="auth-form">
    <h1>Reset your password</h1>
    <p class="lede">Enter your account email and we will send you a reset link.</p>
    <form method="post" action="/forgot" class="form">
      <label>Email
        <input name="email" type="email" value="<%= values && values.email || '' %>" autocomplete="email" required>
      </label>
      <button class="primary big" type="submit">Send link</button>
    </form>
    <ul class="auth-links"><li><a href="/login">Back to sign in</a></li></ul>
  </div>
  <figure class="auth-photo">
    <img src="/static/img/scenes/winter.jpg" alt="An Icelandic horse in a snowy field">
  </figure>
</section>
<%- include('partials/foot') %>
