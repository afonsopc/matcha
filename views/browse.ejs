<%- include('partials/head', { title: 'Suggestions' }) %>
<header class="page-head">
  <div>
    <h1>Suggestions</h1>
    <p class="lede">Sorted by distance, shared interests and fame.</p>
  </div>
  <p class="count"><%= profiles.length %> <%= profiles.length === 1 ? 'horse' : 'horses' %></p>
</header>

<%- include('partials/filters', { submitLabel: 'Apply' }) %>

<% if (!profiles.length) { %>
  <section class="empty">
      <h2>No suggestions</h2>
      <p>Loosen the filters, or make sure your profile has a gender, a preference and a location.</p>
      <div class="actions"><a class="button primary" href="/profile">Finish my profile</a><a class="button" href="/browse">Reset filters</a></div>
    </section>
<% } else { %>
  <section class="cards">
    <% profiles.forEach(p => { %><%- include('partials/card', { p }) %><% }) %>
  </section>
<% } %>
<%- include('partials/foot') %>
