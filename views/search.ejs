<%- include('partials/head', { title: 'Search' }) %>
<header class="page-head">
  <div>
    <h1>Search</h1>
    <p class="lede">Filter by age, fame, place and interests.</p>
  </div>
  <% if (profiles !== null) { %><p class="count"><%= profiles.length %> <%= profiles.length === 1 ? 'result' : 'results' %></p><% } %>
</header>

<%- include('partials/filters', { submitLabel: 'Search' }) %>

<% if (profiles === null) { %>
  <section class="empty">
    <h2>Nothing searched yet</h2>
    <p>Set a filter above, or go back to your <a href="/browse">suggestions</a>.</p>
  </section>
<% } else if (!profiles.length) { %>
  <section class="empty">
      <h2>No results</h2>
      <p>Try a wider age or fame range, another place, or fewer interests.</p>
    </section>
<% } else { %>
  <section class="cards">
    <% profiles.forEach(p => { %><%- include('partials/card', { p }) %><% }) %>
  </section>
<% } %>
<%- include('partials/foot') %>
