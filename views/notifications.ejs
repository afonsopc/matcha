<%- include('partials/head', { title: 'Notifications' }) %>
<header class="page-head">
  <div>
    <h1>Notifications</h1>
    <p class="lede">Newest first.</p>
  </div>
</header>
<% if (!notifications.length) { %>
  <section class="empty">
    <h2>Nothing yet</h2>
    <p>Likes, visits, matches and messages will show up here.</p>
  </section>
<% } else { %>
  <% const ICONS = { like: 'i-heart', match: 'i-heart', message: 'i-chat', visit: 'i-eye', unlike: 'i-split' }; %>
  <ul class="notifications">
    <% notifications.forEach(n => { %>
      <li class="<%= n.read_at ? '' : 'unread' %> <%= n.type %>">
        <span class="n-avatar">
          <% if (n.actor_photo) { %><img src="/static/uploads/<%= n.actor_photo %>" alt=""><% } %>
          <span class="n-type"><svg class="ico"><use href="#<%= ICONS[n.type] || 'i-bell' %>"/></svg></span>
        </span>
        <div class="n-body">
          <p><%= n.body %></p>
          <small><%
            const seconds = Math.floor(Date.now() / 1000) - Number(n.created_at);
            if (seconds < 60) { %>just now<% }
            else if (seconds < 3600) { %><%= Math.floor(seconds / 60) %> min ago<% }
            else if (seconds < 86400) { %><%= Math.floor(seconds / 3600) %> h ago<% }
            else { %><%= Math.floor(seconds / 86400) %> d ago<% } %></small>
        </div>
        <% if (n.link) { %>
          <a class="button small" href="<%= n.link %>"><%= n.type === 'message' || n.type === 'match' ? 'Reply' : 'View' %></a>
        <% } else if (n.actor_username) { %>
          <a class="button small" href="/users/<%= n.actor_username %>">View</a>
        <% } %>
      </li>
    <% }) %>
  </ul>
<% } %>
<%- include('partials/foot') %>
