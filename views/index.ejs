<%- include('partials/head', { title: 'Dating for horses', bodyClass: 'home' }) %>
<section class="landing">
  <div class="landing-copy">
    <h1>Dating for horses.</h1>
    <p class="offer">Meet horses near you who like what you like. When the like goes both ways, you can talk.</p>
    <div class="actions">
      <a class="button primary big" href="/register">Create an account</a>
      <a class="button big" href="/login">Sign in</a>
    </div>
    <p class="field-note"><%= totals.horses %> horses in <%= totals.towns %> towns</p>
  </div>
  <div class="landing-grid">
    <% sample.forEach(h => { %>
      <figure class="card">
        <div class="card-photo"><img src="/static/uploads/<%= h.profile_photo %>" alt="<%= h.first_name %>"></div>
        <figcaption class="card-text">
          <h2><%= h.first_name %><% if (h.age) { %><span>, <%= h.age %></span><% } %></h2>
          <p><%= [h.breed, h.city].filter(Boolean).join(' · ') %></p>
        </figcaption>
      </figure>
    <% }) %>
  </div>
</section>
<%- include('partials/foot') %>
