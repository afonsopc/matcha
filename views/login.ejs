<%- include('partials/head', { title: 'Sign in' }) %>
<section class="auth">
  <div class="auth-form">
    <h1>Sign in</h1>
    <form method="post" action="/login" class="form" autocomplete="on">
      <label>Username
        <input name="username" value="<%= values && values.username || '' %>" autocomplete="username" autofocus required>
      </label>
      <label>Password
        <span class="pw-wrapper">
          <input name="password" type="password" autocomplete="current-password" data-password="toggle" required>
        </span>
      </label>
      <button class="primary big" type="submit">Sign in</button>
    </form>
    <ul class="auth-links">
      <li><a href="/forgot">Forgot password?</a></li>
      <li><a href="/resend-verification">Resend confirmation email</a></li>
      <li>No account? <a href="/register">Sign up</a></li>
    </ul>
  </div>
  <figure class="auth-photo">
    <img src="/static/img/scenes/portrait.jpg" alt="Close-up of a chestnut horse with a long blond mane">
  </figure>
</section>
<%- include('partials/foot') %>
