<%- include('partials/head') %>
<section class="grid two">
  <article class="panel">
    <div class="profile-head">
      <% if (profile.profile_photo) { %>
        <img class="avatar" src="/static/uploads/<%= profile.profile_photo %>" alt="" data-lightbox>
      <% } else { %>
        <div class="placeholder" style="border-radius:14px;width:160px;height:160px;display:grid;place-items:center;">No photo</div>
      <% } %>
      <div>
        <h1><%= profile.first_name %> <%= profile.last_name %><%= age ? ', ' + age : '' %></h1>
        <p>@<%= profile.username %> · <span class="fame-pill">Fame <%= profile.fame %></span></p>
        <p><span class="online-dot <%= profile.online ? 'live' : '' %>"></span><%= lastSeenText(profile) %></p>
        <p>
          <%= profile.gender ? profile.gender.charAt(0).toUpperCase() + profile.gender.slice(1) : 'Gender unspecified' %>
          · interested in <%= profile.preference === 'bisexual' ? 'everyone' : (profile.preference || 'everyone') %>
        </p>
        <p><%= [profile.city, profile.neighborhood].filter(Boolean).join(', ') || 'Location not set' %><%= distance !== null ? ' · ' + formatDistance(distance) : '' %></p>
        <% if (isConnected) { %>
          <span class="match-pill">Connected</span>
        <% } else if (likedMe) { %>
          <span class="match-pill warn">They liked you</span>
        <% } else if (liked) { %>
          <span class="match-pill warn">You liked them</span>
        <% } %>
      </div>
    </div>

    <% if (typeof query !== 'undefined' && query && query.need_photo) { %>
      <p class="flash warn">You need a profile picture before you can like anyone. Add one on your <a href="/profile">profile</a>.</p>
    <% } %>
    <% if (typeof query !== 'undefined' && query && query.reported) { %>
      <p class="flash notice">Report recorded.</p>
    <% } %>

    <h2>About</h2>
    <p style="white-space:pre-wrap;"><%= profile.bio || 'No bio.' %></p>

    <% if (tags.length) { %>
      <h2>Interests</h2>
      <div class="tags"><% tags.forEach(t => { %><span>#<%= t.name %></span><% }) %></div>
    <% } %>

    <h2>Actions</h2>
    <div class="actions">
      <% if (liked) { %>
        <form method="post" action="/users/<%= profile.id %>/unlike" data-confirm="Remove your like?">
          <button type="submit">Remove like</button>
        </form>
      <% } else if (!youHavePhoto) { %>
        <button type="button" disabled title="Add a profile picture first">Like</button>
        <span class="hint">A profile picture is required to like other users.</span>
      <% } else { %>
        <form method="post" action="/users/<%= profile.id %>/like">
          <button type="submit" class="primary">Like</button>
        </form>
      <% } %>
      <% if (isConnected) { %>
        <a class="button" href="/chat?with=<%= profile.id %>">Open chat</a>
      <% } %>
      <form method="post" action="/users/<%= profile.id %>/report" data-confirm="Report this profile as fake?">
        <button type="submit" class="ghost small">Report fake</button>
      </form>
      <form method="post" action="/users/<%= profile.id %>/block" data-confirm="Block this user?">
        <button type="submit" class="danger small">Block</button>
      </form>
    </div>
  </article>
  <aside class="panel">
    <h2 style="margin-top:0;">Photos</h2>
    <% if (!photos.length) { %>
      <p class="hint">No photos.</p>
    <% } else { %>
      <div class="photo-gallery">
        <% photos.forEach(photo => { %>
          <img src="/static/uploads/<%= photo.filename %>" alt="" data-lightbox>
        <% }) %>
      </div>
    <% } %>
  </aside>
</section>
<%- include('partials/foot') %>
