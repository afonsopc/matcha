<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' && title ? title + ' · ' : '' %>Matcha</title>
  <meta name="description" content="Matcha, dating for horses.">
  <meta name="theme-color" content="#ffffff">
  <link rel="preload" href="/static/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/static/css/app.css">
  <link rel="icon" type="image/svg+xml" href="/static/img/favicon.svg">
  <script src="/socket.io/socket.io.js" defer></script>
  <script src="/static/js/app.js" defer></script>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>"<% if (user) { %> data-user-id="<%= user.id %>"<% } %>>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="i-heart" viewBox="0 0 24 24"><path d="M12 20.5S3 15 3 8.8C3 6 5.1 4 7.7 4c1.8 0 3.3 1 4.3 2.4C13 5 14.5 4 16.3 4 18.9 4 21 6 21 8.8 21 15 12 20.5 12 20.5z" fill="currentColor"/></symbol>
    <symbol id="i-chat" viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4V5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></symbol>
    <symbol id="i-eye" viewBox="0 0 24 24"><path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12z" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" fill="currentColor"/></symbol>
    <symbol id="i-split" viewBox="0 0 24 24"><path d="M12 20.5S3 15 3 8.8C3 6 5.1 4 7.7 4c1.8 0 3.3 1 4.3 2.4l-1.5 3.1 2.6 2.2-2 3.3 1.4 1.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M13.8 5.3C14.7 4.5 15.4 4 16.3 4 18.9 4 21 6 21 8.8c0 4.2-4.1 8.1-6.8 10.2" fill="none" stroke="currentColor" stroke-width="2"/></symbol>
    <symbol id="i-pin" viewBox="0 0 24 24"><path d="M12 21s-6.5-6.6-6.5-11.3a6.5 6.5 0 0 1 13 0C18.5 14.4 12 21 12 21z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="12" cy="9.7" r="2.3" fill="none" stroke="currentColor" stroke-width="2"/></symbol>
    <symbol id="i-bell" viewBox="0 0 24 24"><path d="M6 16V11a6 6 0 0 1 12 0v5l2 2H4l2-2zM10 20a2 2 0 0 0 4 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></symbol>
    <symbol id="i-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></symbol>
    <symbol id="i-grid" viewBox="0 0 24 24"><path d="M4.5 4.5h6v6h-6zM13.5 4.5h6v6h-6zM4.5 13.5h6v6h-6zM13.5 13.5h6v6h-6z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></symbol>
    <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8.5" r="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M4.5 20c1.2-3.6 4-5.5 7.5-5.5s6.3 1.9 7.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
    <symbol id="i-logout" viewBox="0 0 24 24"><path d="M14 4H6v16h8M10 12h10m-3.5-3.5L20 12l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/></symbol>
    <symbol id="i-flag" viewBox="0 0 24 24"><path d="M5 22V3m0 1h12l-2 4 2 4H5" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></symbol>
    <symbol id="i-block" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="m6 6 12 12" stroke="currentColor" stroke-width="2"/></symbol>
    <symbol id="i-close" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="square"/></symbol>
    <symbol id="i-back" viewBox="0 0 24 24"><path d="M20 12H5m6-6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.4"/></symbol>
    <symbol id="i-send" viewBox="0 0 24 24"><path d="M3 20 21 12 3 4l2.5 8L3 20zM5.5 12H13" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></symbol>
  </svg>
  <header class="topbar">
    <a class="brand" href="/">matcha</a>
    <nav aria-label="Main">
      <% if (user) { %>
        <a href="/browse" class="<%= currentPath === '/browse' ? 'active' : '' %>"><svg class="ico"><use href="#i-grid"/></svg><span>Browse</span></a>
        <a href="/search" class="<%= currentPath === '/search' ? 'active' : '' %>"><svg class="ico"><use href="#i-search"/></svg><span>Search</span></a>
        <a href="/chat" class="<%= currentPath === '/chat' ? 'active' : '' %>"><svg class="ico"><use href="#i-chat"/></svg><span>Chat</span><span class="badge" data-badge="messages"<%= unreadMessages ? '' : ' hidden' %>><%= unreadMessages %></span></a>
        <a href="/notifications" class="<%= currentPath === '/notifications' ? 'active' : '' %>"><svg class="ico"><use href="#i-bell"/></svg><span>Notifications</span><span class="badge" data-badge="notifications"<%= unreadCount ? '' : ' hidden' %>><%= unreadCount %></span></a>
        <a href="/profile" class="me <%= currentPath === '/profile' ? 'active' : '' %>" aria-label="Your profile"><svg class="ico"><use href="#i-user"/></svg><span>@<%= user.username %></span></a>
        <form action="/logout" method="post"><button class="linkish" type="submit" aria-label="Log out"><svg class="ico"><use href="#i-logout"/></svg><span>Log out</span></button></form>
      <% } else { %>
        <a href="/login" class="signin <%= currentPath === '/login' ? 'active' : '' %>">Sign in</a>
        <a href="/register" class="cta">Sign up</a>
      <% } %>
    </nav>
  </header>
  <main class="shell">
    <% if (typeof error !== 'undefined' && error) { %><p class="flash error" role="alert"><%= error %></p><% } %>
    <% if (typeof notice !== 'undefined' && notice) { %><p class="flash notice" role="status"><%= notice %></p><% } %>
